# IMAP server connection settings (required)
IMAP_HOST=imap.example.com
IMAP_USER=you@example.com
IMAP_PASS=your-password

# Optional — defaults shown
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_STARTTLS=true
# IMAP_TLS_REJECT_UNAUTHORIZED=true

# Multiple accounts: a directory with one settings file per account (see README).
# While set, the IMAP_* settings above are ignored.
# IMAP_ACCOUNTS_DIR=/path/to/accounts
